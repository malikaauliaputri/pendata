from flask import Flask, render_template, request
import joblib
import numpy as np

app = Flask(__name__)

# Load model dan scaler
model = joblib.load("logistic_regression_model.pkl")
scaler = joblib.load("scaler.pkl")

@app.route("/", methods=["GET", "POST"])
def index():
    prediction = None
    if request.method == "POST":
        try:
            data = [
                float(request.form.get("fresh", 0)),
                float(request.form.get("milk", 0)),
                float(request.form.get("grocery", 0)),
                float(request.form.get("frozen", 0)),
                float(request.form.get("detergents", 0)),
                float(request.form.get("delicassen", 0)),
                float(request.form.get("region", 3))  # default region 3
            ]
            data_np = np.array(data).reshape(1, -1)
            scaled_data = scaler.transform(data_np)
            result = model.predict(scaled_data)[0]
            prediction = "Retail (Channel 1)" if result == 1 else "Horeca (Channel 0)"
        except Exception as e:
            prediction = f"❌ Error: {str(e)}"

    return render_template("index.html", prediction=prediction)

if __name__ == "__main__":
    app.run(debug=True)
